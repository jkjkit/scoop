{
    "version": "latest",
    "description": "LX Music Desktop - 一个基于 Electron + Vue 开发的音乐软件",
    "homepage": "https://github.com/lyswhut/lx-music-desktop",
    "license": "Apache-2.0",
    "notes": "由于未使用硬编码哈希，请在首次或更新安装时加上 --no-hash 参数。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/lyswhut/lx-music-desktop/releases/download/v$matchVersion/lx-music-desktop-v$matchVersion-win_x64-green.7z",
            "hash": "skipped"
        }
    },
    "bin": "lx-music-desktop.exe",
    "shortcuts": [
        [
            "lx-music-desktop.exe",
            "LX Music Desktop"
        ]
    ],
    "env": {
        "PORTABLE_EXECUTABLE_DIR": "$dir"
    },
    "checkver": {
        "url": "https://github.com/lyswhut/lx-music-desktop/releases/latest",
        "re": "/releases/download/v(?<version>[\\d.]+)/lx-music-desktop-v[\\d.]+-win_x64-green.7z"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lyswhut/lx-music-desktop/releases/download/v$version/lx-music-desktop-v$version-win_x64-green.7z"
            }
        }
    }
}
