            "hash": "720be8d8ba98b46620d775a8108e2c55d18bb192b89b27e336406869374882ca"
        }
    },
    "pre_install": [
        "if (Test-Path \"$dir\\DocBox.exe\") {",
        "    Write-Host '正在动态调用本地 7z 引擎执行物理拆包...' -ForegroundColor Cyan",
        "    Rename-Item \"$dir\\DocBox.exe\" \"setup.exe\"",
        "    $sevenZip = \"$global:scoopdir\\apps\\7zip\\current\\7z.exe\"",
        "    if (-not (Test-Path $sevenZip)) { $sevenZip = \"7z.exe\" }",
        "    & $sevenZip x \"$dir\\setup.exe\" \"-o$dir\" -y | Out-Null",
        "    Remove-Item \"$dir\\setup.exe\" -Force",
        "}"
    ],
    "bin": "DocBox.exe",
    "shortcuts": [
        [
            "DocBox.exe",
            "稻壳阅读器"
        ]
    ]
}
