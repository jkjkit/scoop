{
  "version": "2.12.74",
  "description": "DocBox - 稻壳阅读器，高效、便捷的文档管理与 PDF/XDF/EPUB 归档工具",
  "homepage": "https://www.daokereader.com/",
  "license": "Freeware",
  "architecture": {
    "64bit": {
      "url": "https://dogpan.com/f/YELqUA/DocBox2.12.74.7z",
      "hash": "720be8d8ba98b46620d775a8108e2c55d18bb192b89b27e336406869374882ca"
    }
  },
  "pre_install": [
    "if (Test-Path \"$dir\\DocBox.exe\") {",
    "  Write-Host '正在静默安装到 Scoop 目录...' -ForegroundColor Cyan",
    "  Start-Process \"$dir\\DocBox.exe\" -ArgumentList \"/S /D=$dir\" -Wait",
    "  Remove-Item \"$dir\\DocBox.exe\" -Force -ErrorAction SilentlyContinue",
    "}"
  ],
  "uninstaller": {
    "script": [
      "$uninstaller = \"$dir\\uninst.exe\"",
      "if (Test-Path $uninstaller) {",
      "  Start-Process $uninstaller -ArgumentList '/S' -Wait",
      "}"
    ]
  },
  "bin": "DocBox.exe",
  "shortcuts": [
    [
      "DocBox.exe",
      "稻壳阅读器"
    ]
  ]
}
